# ── Data source ────────────────────────────────────────────────────────────────
# "local"  (default) → reads/writes the folder in DATA_LOCAL_DIR; no GitHub needed. Great for trying things out.
# "github"           → reads/writes the real database repo (the one named in database.json) through the GitHub API.
DATA_PROVIDER=local

# Local mode: a folder laid out like the database repo. Defaults to ./local-data (a seeded copy).
# Point it at a clone of the database repo to edit the real files:  DATA_LOCAL_DIR=../database
# DATA_LOCAL_DIR=local-data

# GitHub mode ───────────────────────────────────────────────────────────────────
# Which repo/branch is the database is NOT configured here: see database.json at the root of this repo.
# Fine-grained personal access token with "Contents: read and write" on the database repo only.
# Never commit it. In production it is a Worker secret that the deploy workflow uploads from the
# GitHub secret DATABASE_REPO_TOKEN (GitHub does not allow secret names starting with GITHUB_).
# GITHUB_TOKEN=github_pat_...

# ── Login ──────────────────────────────────────────────────────────────────────
# Generate both values with:  pnpm hash-password
ADMIN_PASSWORD_HASH=put_the_sha256_hash_here
AUTH_SESSION_SECRET=put_a_long_random_string_here

# ── Optional ───────────────────────────────────────────────────────────────────
# The website's address (Preview button + "Open website" link) is the "website" field of database.json.
# Set this only to override it for a local run, e.g. a website started with `pnpm dev -p 3001`
# (the website's database.json then needs "admin": "http://localhost:3000", or NEXT_PUBLIC_ADMIN_ORIGIN).
# NEXT_PUBLIC_WEBSITE_URL=http://localhost:3001

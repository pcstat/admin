# ── Data source ────────────────────────────────────────────────────────────────
# "local"  (default) → reads/writes the folder in DATA_LOCAL_DIR; no GitHub needed. Great for trying things out.
# "github"           → reads/writes the real database repo through the GitHub API.
DATA_PROVIDER=local

# Local mode: a folder laid out like the database repo. Defaults to ./local-data (a seeded copy).
# Point it at a clone of the database repo to edit the real files:  DATA_LOCAL_DIR=../programming-club-demo-data
# DATA_LOCAL_DIR=local-data

# GitHub mode ───────────────────────────────────────────────────────────────────
# Fine-grained personal access token with "Contents: read and write" on the database repo only.
# Never commit it — in Cloudflare it is an encrypted secret (`pnpm wrangler secret put GITHUB_TOKEN`).
# GITHUB_TOKEN=github_pat_...
# DATABASE_REPO=owner/programming-club-demo-data
# DATABASE_BRANCH=main

# ── Login ──────────────────────────────────────────────────────────────────────
# Generate both values with:  pnpm hash-password
ADMIN_PASSWORD_HASH=put_the_sha256_hash_here
AUTH_SESSION_SECRET=put_a_long_random_string_here

# ── Optional ───────────────────────────────────────────────────────────────────
# Link to the live website shown in the sidebar.
# NEXT_PUBLIC_WEBSITE_URL=https://programming-club-demo.pages.dev
